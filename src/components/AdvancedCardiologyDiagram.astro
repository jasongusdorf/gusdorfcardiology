---
type Kind = 'bayes' | 'echo-windows' | 'biomarker-tree' | 'hemodynamics' | 'valve-load' | 'heart-failure-map' | 'af-map' | 'shock-map';
const { kind } = Astro.props as { kind: Kind };
const meta: Record<Kind, [string, string]> = {
  bayes: ['Testing changes probability—it does not create certainty', 'Tests help most when the starting probability is neither very low nor already decisive. Define the action threshold before ordering.'],
  'echo-windows': ['Four windows, complementary questions', 'Name the window and view before interpreting. No single view is a complete echocardiogram.'],
  'biomarker-tree': ['An elevated troponin is the start of reasoning', 'First decide whether injury is acute; then ask whether ischemia is present. Infarction requires both injury and clinical evidence of ischemia.'],
  hemodynamics: ['Follow pressure, saturation, and flow together', 'A catheterization is one linked physiologic story. Verify waveforms and source measurements before trusting calculated resistance.'],
  'valve-load': ['Stenosis and regurgitation create different loads', 'Stenosis primarily creates pressure load; regurgitation creates volume load. Acute and chronic lesions produce different chamber responses.'],
  'heart-failure-map': ['Heart failure: stabilize today, change tomorrow', 'Treat congestion and perfusion now while identifying etiology and establishing therapies that alter long-term risk.'],
  'af-map': ['Atrial fibrillation has four simultaneous jobs', 'Stability, stroke prevention, symptom control, and substrate modification should be considered in parallel—not as isolated steps.'],
  'shock-map': ['Shock phenotypes predict opposite treatments', 'Use preload, pump function, vascular tone, and obstruction to identify the mechanism; reassess after every intervention.'],
};
const [title, caption] = meta[kind];
---

<figure class="my-8 overflow-hidden rounded-2xl border border-clinical-200 bg-[#fbf8f1] dark:border-clinical-700 dark:bg-clinical-900" aria-labelledby={`advanced-${kind}`}>
  <div class="border-b border-clinical-200 px-5 py-4 dark:border-clinical-700"><p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-700 dark:text-blue-300">Mechanism map</p><h2 id={`advanced-${kind}`} class="mt-1 font-heading text-2xl font-semibold text-clinical-900 dark:text-white">{title}</h2></div>

  {kind === 'bayes' && <svg viewBox="0 0 900 440" role="img" aria-label="Pretest probability moves through a test result toward treatment thresholds"><defs><marker id="a-bayes" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="#526273"/></marker></defs><g class="edges" marker-end="url(#a-bayes)"><path d="M225 195H340"/><path d="M560 195H675"/><path d="M450 250V335"/></g><g class="node"><rect x="45" y="125" width="180" height="140" rx="18"/><text x="135" y="170">PRETEST</text><text x="135" y="198">probability</text><text class="sub" x="135" y="230">history · exam · prevalence</text></g><g class="decision"><rect x="340" y="110" width="220" height="170" rx="24"/><text x="450" y="155">TEST RESULT</text><text class="pos" x="450" y="195">positive LR → probability ↑</text><text class="neg" x="450" y="230">negative LR → probability ↓</text></g><g class="node"><rect x="675" y="125" width="180" height="140" rx="18"/><text x="765" y="170">POST-TEST</text><text x="765" y="198">probability</text><text class="sub" x="765" y="230">not simply “yes” or “no”</text></g><g class="threshold"><rect x="285" y="335" width="330" height="65" rx="16"/><text x="450" y="362">Did we cross an action threshold?</text><text class="sub" x="450" y="385">stop · test again · treat</text></g><text class="note" x="450" y="70">Very low probability → false positives dominate · Very high probability → intermediate testing may add little</text></svg>}

  {kind === 'echo-windows' && <svg viewBox="0 0 900 500" role="img" aria-label="Four echocardiographic windows and the questions each answers"><defs><marker id="a-echo" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="#526273"/></marker></defs><g class="edges" marker-end="url(#a-echo)"><path d="M450 245L225 150"/><path d="M450 245L675 150"/><path d="M450 245L225 365"/><path d="M450 245L675 365"/></g><circle class="hub" cx="450" cy="245" r="82"/><text x="450" y="232">CLINICAL</text><text x="450" y="258">QUESTION</text><g class="node"><rect x="70" y="70" width="310" height="120" rx="18"/><text x="225" y="105">PARASTERNAL</text><text class="sub" x="225" y="135">valves · LV walls · outflow</text><text class="sub" x="225" y="160">long axis + short axis</text></g><g class="node"><rect x="520" y="70" width="310" height="120" rx="18"/><text x="675" y="105">APICAL</text><text class="sub" x="675" y="135">all chambers · EF · Doppler</text><text class="sub" x="675" y="160">four / two / three chamber</text></g><g class="node"><rect x="70" y="310" width="310" height="120" rx="18"/><text x="225" y="345">SUBCOSTAL</text><text class="sub" x="225" y="375">effusion · septum · IVC</text><text class="sub" x="225" y="400">often useful in critical illness</text></g><g class="node"><rect x="520" y="310" width="310" height="120" rx="18"/><text x="675" y="345">SUPRASTERNAL</text><text class="sub" x="675" y="375">aortic arch · coarctation</text><text class="sub" x="675" y="400">great-vessel Doppler</text></g><text class="note" x="450" y="470">2D anatomy + color direction + spectral velocity + tissue motion</text></svg>}

  {kind === 'biomarker-tree' && <svg viewBox="0 0 900 520" role="img" aria-label="Decision tree for interpreting elevated troponin"><defs><marker id="a-trop" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="#526273"/></marker></defs><g class="edges" marker-end="url(#a-trop)"><path d="M450 115V170"/><path d="M390 235L225 300"/><path d="M510 235L675 300"/><path d="M675 370V430"/></g><g class="decision"><rect x="295" y="45" width="310" height="70" rx="18"/><text x="450" y="75">TROPONIN ABOVE 99TH PERCENTILE</text><text class="sub" x="450" y="98">myocardial injury exists</text></g><g class="decision"><rect x="315" y="170" width="270" height="65" rx="18"/><text x="450" y="198">Rise and/or fall?</text><text class="sub" x="450" y="220">use assay + time interval</text></g><g class="node"><rect x="70" y="300" width="310" height="120" rx="18"/><text x="225" y="335">NO → CHRONIC INJURY</text><text class="sub" x="225" y="365">CKD · structural disease</text><text class="sub" x="225" y="390">interpret baseline + context</text></g><g class="risk"><rect x="520" y="300" width="310" height="120" rx="18"/><text x="675" y="335">YES → ACUTE INJURY</text><text class="sub" x="675" y="365">Is there clinical ischemia?</text><text class="sub" x="675" y="390">symptoms · ECG · imaging · thrombus</text></g><g class="threshold"><rect x="520" y="430" width="310" height="60" rx="16"/><text x="675" y="457">Ischemia present → myocardial infarction</text><text class="sub" x="675" y="480">then determine mechanism/type</text></g></svg>}

  {kind === 'hemodynamics' && <svg viewBox="0 0 900 470" role="img" aria-label="Right heart catheter path with pressures and resistance equation"><defs><marker id="a-hemo" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="#526273"/></marker></defs><g class="edges" marker-end="url(#a-hemo)"><path d="M170 190H260"/><path d="M380 190H470"/><path d="M590 190H680"/></g><g class="ven"><rect x="40" y="125" width="130" height="130" rx="22"/><text x="105" y="165">RA</text><text class="sub" x="105" y="195">a · x · v · y</text><text class="sub" x="105" y="220">preload / venous pressure</text></g><g class="ven"><rect x="260" y="125" width="120" height="130" rx="22"/><text x="320" y="165">RV</text><text class="sub" x="320" y="195">systolic + EDP</text><text class="sub" x="320" y="220">pump pressure</text></g><g class="lung"><rect x="470" y="125" width="120" height="130" rx="22"/><text x="530" y="165">PA</text><text class="sub" x="530" y="195">s / d / mean</text><text class="sub" x="530" y="220">pulmonary load</text></g><g class="left"><rect x="680" y="125" width="180" height="130" rx="22"/><text x="770" y="165">PCWP</text><text class="sub" x="770" y="195">a · v · mean</text><text class="sub" x="770" y="220">estimate of LA pressure</text></g><g class="formula"><rect x="180" y="325" width="540" height="82" rx="18"/><text x="450" y="355">PVR = (mean PA − PCWP) ÷ cardiac output</text><text class="sub" x="450" y="383">A resistance is a pressure gradient divided by flow</text></g><text class="note" x="450" y="75">Level + zero → waveform fidelity → end-expiratory pressure → saturation → flow → derived values</text></svg>}

  {kind === 'valve-load' && <svg viewBox="0 0 900 480" role="img" aria-label="Comparison of stenosis pressure load and regurgitation volume load"><defs><marker id="a-valve" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="#526273"/></marker></defs><g class="edges" marker-end="url(#a-valve)"><path d="M225 165V235"/><path d="M675 165V235"/><path d="M225 315V390"/><path d="M675 315V390"/></g><g class="risk"><rect x="75" y="75" width="300" height="90" rx="18"/><text x="225" y="110">STENOSIS</text><text class="sub" x="225" y="140">fixed obstruction to forward flow</text></g><g class="decision"><rect x="525" y="75" width="300" height="90" rx="18"/><text x="675" y="110">REGURGITATION</text><text class="sub" x="675" y="140">backward flow through poor closure</text></g><g class="node"><rect x="75" y="235" width="300" height="80" rx="18"/><text x="225" y="268">PRESSURE LOAD</text><text class="sub" x="225" y="295">concentric adaptation · gradient</text></g><g class="node"><rect x="525" y="235" width="300" height="80" rx="18"/><text x="675" y="268">VOLUME LOAD</text><text class="sub" x="675" y="295">dilation · repeated stroke volume</text></g><g class="threshold"><rect x="75" y="390" width="300" height="55" rx="16"/><text x="225" y="415">severity + chamber response + symptoms</text><text class="sub" x="225" y="435">determine timing of intervention</text></g><g class="threshold"><rect x="525" y="390" width="300" height="55" rx="16"/><text x="675" y="415">acute ≠ chronic compensation</text><text class="sub" x="675" y="435">tempo changes pressure and findings</text></g></svg>}

  {kind === 'heart-failure-map' && <svg viewBox="0 0 900 500" role="img" aria-label="Heart failure framework from bedside phenotype to long term treatment"><defs><marker id="a-hf" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="#526273"/></marker></defs><g class="edges" marker-end="url(#a-hf)"><path d="M450 125V180"/><path d="M360 245L190 320"/><path d="M540 245L710 320"/></g><g class="decision"><rect x="285" y="45" width="330" height="80" rx="20"/><text x="450" y="77">HEART FAILURE SYNDROME</text><text class="sub" x="450" y="103">objective congestion and/or low output</text></g><g class="node"><rect x="295" y="180" width="310" height="65" rx="18"/><text x="450" y="207">Phenotype + cause + precipitant</text><text class="sub" x="450" y="230">EF is one axis—not the diagnosis</text></g><g class="risk"><rect x="50" y="320" width="280" height="125" rx="18"/><text x="190" y="352">TODAY</text><text class="sub" x="190" y="382">decongest · restore perfusion</text><text class="sub" x="190" y="407">treat precipitant · reassess</text><text class="sub" x="190" y="430">wet/dry + warm/cold</text></g><g class="good"><rect x="570" y="320" width="280" height="125" rx="18"/><text x="710" y="352">LONG TERM</text><text class="sub" x="710" y="382">etiology-specific therapy</text><text class="sub" x="710" y="407">HFrEF pillars / HFpEF strategy</text><text class="sub" x="710" y="430">devices · rehab · comorbidity</text></g><text class="note" x="450" y="475">Every visit: symptoms · volume · BP · kidneys/electrolytes · adherence · trajectory</text></svg>}

  {kind === 'af-map' && <svg viewBox="0 0 900 500" role="img" aria-label="Four domains of atrial fibrillation management"><defs><marker id="a-af" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto"><path d="M0 0L8 4L0 8Z" fill="#526273"/></marker></defs><g class="edges" marker-end="url(#a-af)"><path d="M450 250L220 135"/><path d="M450 250L680 135"/><path d="M450 250L220 375"/><path d="M450 250L680 375"/></g><circle class="hub" cx="450" cy="250" r="83"/><text x="450" y="238">ATRIAL</text><text x="450" y="265">FIBRILLATION</text><g class="risk"><rect x="65" y="65" width="310" height="120" rx="18"/><text x="220" y="100">1 · STABILITY</text><text class="sub" x="220" y="130">shock / ischemia / pulmonary edema?</text><text class="sub" x="220" y="157">unstable → synchronized cardioversion</text></g><g class="node"><rect x="525" y="65" width="310" height="120" rx="18"/><text x="680" y="100">2 · STROKE</text><text class="sub" x="680" y="130">risk + bleeding + eligibility</text><text class="sub" x="680" y="157">anticoagulation when net benefit</text></g><g class="decision"><rect x="65" y="315" width="310" height="120" rx="18"/><text x="220" y="350">3 · SYMPTOMS</text><text class="sub" x="220" y="380">rate versus rhythm strategy</text><text class="sub" x="220" y="407">drugs · cardioversion · ablation</text></g><g class="good"><rect x="525" y="315" width="310" height="120" rx="18"/><text x="680" y="350">4 · SUBSTRATE</text><text class="sub" x="680" y="380">weight · exercise · BP · apnea</text><text class="sub" x="680" y="407">alcohol · diabetes · HF</text></g><text class="note" x="450" y="475">Rhythm status and anticoagulation decisions are related—but not identical</text></svg>}

  {kind === 'shock-map' && <svg viewBox="0 0 900 520" role="img" aria-label="Hemodynamic signatures of four shock categories"><path class="axis" d="M450 65V450M80 260H820"/><text class="head" x="450" y="38">CARDIAC OUTPUT</text><text class="sub" x="265" y="58">low</text><text class="sub" x="635" y="58">often high early</text><text class="head" x="42" y="260" transform="rotate(-90 42 260)">FILLING PRESSURE / VASCULAR TONE</text><g class="node"><rect x="95" y="85" width="300" height="135" rx="18"/><text x="245" y="120">HYPOVOLEMIC</text><text class="sub" x="245" y="150">preload ↓ · CO ↓ · SVR ↑</text><text class="sub" x="245" y="180">replace loss; stop bleeding</text></g><g class="good"><rect x="505" y="85" width="300" height="135" rx="18"/><text x="655" y="120">DISTRIBUTIVE</text><text class="sub" x="655" y="150">SVR ↓ · CO variable</text><text class="sub" x="655" y="180">pressor + cause + selective fluid</text></g><g class="risk"><rect x="95" y="300" width="300" height="135" rx="18"/><text x="245" y="335">CARDIOGENIC</text><text class="sub" x="245" y="365">CO ↓ · filling pressure often ↑</text><text class="sub" x="245" y="395">support pump; treat lesion</text></g><g class="decision"><rect x="505" y="300" width="300" height="135" rx="18"/><text x="655" y="335">OBSTRUCTIVE</text><text class="sub" x="655" y="365">CO ↓ despite blocked filling/flow</text><text class="sub" x="655" y="395">relieve PE / tamponade / tension</text></g><text class="note" x="450" y="485">Mixed shock is common. Trends after intervention are part of the diagnosis.</text></svg>}

  <figcaption class="border-t border-clinical-200 px-5 py-4 text-sm leading-6 text-clinical-600 dark:border-clinical-700 dark:text-clinical-300">{caption}</figcaption>
</figure>

<style>
svg{display:block;width:100%;height:auto;padding:1rem;font-family:ui-sans-serif,system-ui,-apple-system,sans-serif}svg text{fill:#263746;stroke:none;text-anchor:middle;font-size:15px;font-weight:700}.sub{font-size:11px;font-weight:550;fill:#647382}.note{font-size:12px;font-weight:650;fill:#526273}.head{font-size:12px;font-weight:800;letter-spacing:.08em;fill:#315f7d}.edges path,.axis{fill:none;stroke:#526273;stroke-width:3}.node rect{fill:#fffdf8;stroke:#8997a2;stroke-width:2}.decision>rect{fill:#dcecf1;stroke:#5b8292;stroke-width:2}.risk>rect{fill:#f4dfd9;stroke:#a76559;stroke-width:2}.good>rect{fill:#e6efe9;stroke:#699078;stroke-width:2}.threshold>rect,.formula>rect{fill:#eee5d8;stroke:#8f7b60;stroke-width:2}.hub{fill:#315f7d;stroke:#25475e;stroke-width:3}.hub+text,.hub+text+text{fill:white}.ven rect{fill:#dcecf1;stroke:#5b8292;stroke-width:2}.lung rect{fill:#e6efe9;stroke:#699078;stroke-width:2}.left rect{fill:#f4dfd9;stroke:#a76559;stroke-width:2}.pos{fill:#3f7658}.neg{fill:#a33f39}@media(max-width:640px){svg{padding:.25rem}svg text{font-size:12px}.sub{font-size:8px}.note,.head{font-size:9px}}
</style>
