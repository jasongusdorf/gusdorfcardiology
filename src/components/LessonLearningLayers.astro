---
import type { CardiologyLesson } from '../data/cardiology-curriculum';
const { model, color } = Astro.props as { model: NonNullable<CardiologyLesson['learningModel']>; color: string };
---

<section class="my-8 space-y-5" aria-labelledby="learning-layers-heading">
  <div>
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-red-700 dark:text-red-300">Build intuition first</p>
    <h2 id="learning-layers-heading" class="mt-1 font-heading text-2xl font-semibold text-clinical-900 dark:text-white">Three layers of understanding</h2>
    <p class="mt-2 text-sm leading-6 text-clinical-600 dark:text-clinical-300">Start simple, add a mental model, then prove you understand it by teaching the mechanism back without jargon.</p>
  </div>

  <div class="grid gap-5 lg:grid-cols-2">
    <section class="rounded-2xl border border-sky-200 bg-sky-50/70 p-5 dark:border-sky-900 dark:bg-sky-950/20">
      <div class="flex items-center gap-3"><span class="grid h-9 w-9 place-items-center rounded-full bg-sky-700 text-sm font-bold text-white">5</span><h3 class="font-heading text-xl font-semibold text-clinical-900 dark:text-white">Explain it like I’m five</h3></div>
      <p class="mt-4 leading-7 text-clinical-700 dark:text-clinical-200">{model.eli5}</p>
    </section>
    <section class="rounded-2xl border border-violet-200 bg-violet-50/70 p-5 dark:border-violet-900 dark:bg-violet-950/20">
      <div class="flex items-center gap-3"><span class="grid h-9 w-9 place-items-center rounded-full bg-violet-700 text-lg text-white" aria-hidden="true">↔</span><h3 class="font-heading text-xl font-semibold text-clinical-900 dark:text-white">A mental model that sticks</h3></div>
      <p class="mt-4 leading-7 text-clinical-700 dark:text-clinical-200">{model.analogy}</p>
      <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-violet-700 dark:text-violet-300">The analogy is a scaffold—not a substitute for the physiology.</p>
    </section>
  </div>

  <section class="rounded-2xl border border-amber-300 bg-[#fff9e8] p-5 dark:border-amber-800 dark:bg-amber-950/20 sm:p-7">
    <div class="flex flex-col gap-5 md:flex-row md:items-start">
      <div class="shrink-0"><p class="text-xs font-bold uppercase tracking-[0.16em] text-amber-800 dark:text-amber-300">Feynman technique</p><h3 class="mt-1 font-heading text-xl font-semibold text-clinical-900 dark:text-white">Teach it back</h3></div>
      <div class="md:border-l md:border-amber-300 md:pl-6 dark:md:border-amber-800">
        <p class="leading-7 text-clinical-700 dark:text-clinical-200">{model.teachBack}</p>
        <p class="mt-4 text-sm font-semibold text-clinical-900 dark:text-white">Your explanation is complete only if it can answer:</p>
        <ul class="mt-3 grid gap-2 sm:grid-cols-3">
          {model.checkpoints.map((item, index) => <li class="rounded-lg bg-white/80 p-3 text-sm leading-5 text-clinical-700 shadow-sm dark:bg-clinical-900/70 dark:text-clinical-200"><span class="mr-1 font-bold" style={`color:${color}`}>{index + 1}.</span> {item}</li>)}
        </ul>
      </div>
    </div>
  </section>
</section>
