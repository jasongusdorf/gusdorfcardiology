---
const links = [
  { href: '/', label: 'Home', exact: true },
  { href: '/curriculum', label: 'Curriculum' },
  { href: '/ecg', label: 'ECG Library' },
  { href: '/heart-sounds', label: 'Heart Sounds' },
  { href: '/guidelines', label: 'Guidelines' },
];
const path = Astro.url.pathname;
---
<nav class="fixed inset-x-0 top-0 z-50 border-b border-clinical-200/80 bg-clinical-50/90 backdrop-blur-xl dark:border-clinical-700 dark:bg-clinical-900/90" aria-label="Main navigation">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-5 px-4 sm:px-6 lg:px-8">
    <a href="/" class="group mr-auto flex items-center gap-3 text-clinical-900 dark:text-white" aria-label="Gusdorf Cardiology home">
      <span class="grid h-8 w-8 place-items-center rounded-full bg-blue-700 text-white shadow-sm transition group-hover:bg-blue-800">
        <svg viewBox="0 0 32 32" class="h-5 w-5" fill="none" aria-hidden="true"><path d="M3 17h6l2.3-6 4.1 13L19 7l3 10h7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
      <span class="font-heading text-[1.05rem] font-bold tracking-tight">Gusdorf <span class="font-normal text-clinical-500 dark:text-clinical-300">Cardiology</span></span>
    </a>
    <div class="hidden items-center gap-5 md:flex">
      {links.map((link) => <a class:list={["border-b-2 py-5 text-sm font-medium transition", (link.exact ? path === link.href : path.startsWith(link.href)) ? "border-blue-700 text-blue-700 dark:border-blue-300 dark:text-blue-300" : "border-transparent text-clinical-600 hover:text-clinical-900 dark:text-clinical-300 dark:hover:text-white"]} href={link.href}>{link.label}</a>)}
      <a class="rounded-full border border-clinical-300 px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-clinical-700 transition hover:border-blue-700 hover:text-blue-700 dark:border-clinical-600 dark:text-clinical-200" href="https://llmsfordoctors.com/trials?tag=cardiology">AI research ↗</a>
    </div>
    <details class="relative md:hidden">
      <summary class="cursor-pointer list-none rounded-full border border-clinical-300 px-3.5 py-1.5 text-sm dark:border-clinical-600">Menu</summary>
      <div class="absolute right-0 mt-2 w-56 rounded-lg border border-clinical-200 bg-white p-2 shadow-xl dark:border-clinical-700 dark:bg-clinical-800">
        {links.map((link) => <a class="block rounded px-3 py-2 text-sm hover:bg-clinical-100 dark:hover:bg-clinical-700" href={link.href}>{link.label}</a>)}
        <a class="block rounded px-3 py-2 text-sm text-blue-700 dark:text-blue-300" href="https://llmsfordoctors.com/trials?tag=cardiology">AI + Cardiology ↗</a>
      </div>
    </details>
  </div>
</nav>
