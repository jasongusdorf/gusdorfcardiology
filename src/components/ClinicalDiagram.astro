---
type Kind = 'heart-sounds' | 'murmur-maneuvers' | 'jvp' | 'profiles' | 'ecg-territories';
const { kind } = Astro.props as { kind: Kind };
const meta: Record<Kind, [string, string]> = {
  'heart-sounds': ['Heart sounds mapped to the cardiac cycle', 'Time every sound first. S1 begins systole; S2 ends it. S3 follows rapid filling, while S4 requires atrial contraction into a stiff ventricle.'],
  'murmur-maneuvers': ['Dynamic maneuvers change loading conditions', 'Use the physiologic change—not a memorized list—to predict what becomes louder or softer.'],
  jvp: ['The JVP is a right-atrial pressure tracing', 'Read the waveform as events: atrial contraction, atrial relaxation, venous filling, and ventricular filling.'],
  profiles: ['Congestion and perfusion are separate axes', 'A patient can be wet with preserved perfusion or cold without dramatic edema. Classify both axes before choosing treatment.'],
  'ecg-territories': ['Surface leads are regional viewpoints', 'Contiguous leads view related myocardial walls. Reciprocal change in an opposing territory strengthens the inference of acute injury.'],
};
const [title, caption] = meta[kind];
---
<figure class="my-8 overflow-hidden rounded-2xl border border-clinical-200 bg-[#fbf8f1] dark:border-clinical-700 dark:bg-clinical-900">
  <div class="border-b border-clinical-200 px-5 py-4 dark:border-clinical-700"><p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-700 dark:text-blue-300">Clinical diagram</p><h2 class="mt-1 font-heading text-2xl font-semibold text-clinical-900 dark:text-white">{title}</h2></div>
  {kind === 'heart-sounds' && <svg viewBox="0 0 900 380" role="img" aria-label="Timing of heart sounds during systole and diastole"><path class="axis" d="M80 275H830"/><rect class="sys" x="180" y="80" width="280" height="235" rx="12"/><rect class="dia" x="460" y="80" width="310" height="235" rx="12"/><text class="zone" x="320" y="112">SYSTOLE</text><text class="zone" x="615" y="112">DIASTOLE</text><g class="sound"><path d="M180 145V300"/><text x="180" y="137">S1</text><path d="M460 145V300"/><text x="460" y="137">S2</text><path d="M555 190V300"/><text x="555" y="182">S3</text><path d="M735 190V300"/><text x="735" y="182">S4</text></g><g class="labels"><text x="180" y="335">AV valves close</text><text x="460" y="335">aortic/pulmonic close</text><text x="555" y="355">rapid filling</text><text x="735" y="355">atrial contraction</text></g><path class="flow" d="M505 250Q555 205 610 250T720 250"/></svg>}
  {kind === 'murmur-maneuvers' && <svg viewBox="0 0 900 440" role="img" aria-label="Effects of Valsalva, standing, squatting, and handgrip on murmurs"><g transform="translate(45 70)"><text class="head" x="190" y="0">LESS LV VOLUME</text><rect class="box" x="0" y="25" width="180" height="120" rx="16"/><text x="90" y="62">Valsalva strain</text><text x="90" y="88">or standing</text><text class="small" x="90" y="120">↓ preload</text><path class="arrow" d="M200 85H300"/><rect class="up" x="320" y="25" width="160" height="120" rx="16"/><text x="400" y="65">HCM ↑</text><text x="400" y="95">MVP earlier ↑</text><text class="small" x="400" y="122">most others ↓</text></g><g transform="translate(45 260)"><text class="head" x="190" y="0">MORE LV VOLUME / RESISTANCE</text><rect class="box" x="0" y="25" width="180" height="120" rx="16"/><text x="90" y="62">Squat</text><text x="90" y="88">or handgrip</text><text class="small" x="90" y="120">↑ preload / afterload</text><path class="arrow" d="M200 85H300"/><rect class="up" x="320" y="25" width="160" height="120" rx="16"/><text x="400" y="60">MR, AR, VSD ↑</text><text x="400" y="90">HCM ↓</text><text class="small" x="400" y="120">squat makes MVP later</text></g><rect class="call" x="600" y="105" width="245" height="220" rx="18"/><text class="head" x="722" y="145">ASK TWO QUESTIONS</text><text x="722" y="190">1. What changed?</text><text class="small" x="722" y="217">preload, afterload, geometry</text><text x="722" y="265">2. Which gradient?</text><text class="small" x="722" y="292">forward flow, regurgitation,</text><text class="small" x="722" y="312">or dynamic obstruction</text></svg>}
  {kind === 'jvp' && <svg viewBox="0 0 900 430" role="img" aria-label="Jugular venous pulse a c x v y waveform"><path class="axis" d="M70 320H840"/><path class="wave" d="M70 270Q125 270 150 165Q175 270 230 270Q250 245 270 215Q290 285 360 315Q430 310 485 175Q525 260 580 270Q630 270 690 320Q750 285 840 275"/><g class="point"><text x="150" y="145">a</text><text x="270" y="198">c</text><text x="365" y="345">x</text><text x="485" y="155">v</text><text x="690" y="345">y</text></g><g class="guide"><path d="M150 160V385"/><path d="M270 210V385"/><path d="M365 315V385"/><path d="M485 170V385"/><path d="M690 318V385"/></g><g class="labels"><text x="150" y="405">atrial contraction</text><text x="270" y="385">tricuspid closes</text><text x="365" y="405">atrial relaxation</text><text x="485" y="385">venous filling</text><text x="690" y="405">ventricular filling</text></g><text class="head" x="450" y="65">RIGHT ATRIAL PRESSURE OVER ONE CARDIAC CYCLE</text></svg>}
  {kind === 'profiles' && <svg viewBox="0 0 900 500" role="img" aria-label="Two by two congestion and perfusion hemodynamic profiles"><path class="axis" d="M450 65V430M100 250H800"/><text class="head" x="450" y="38">PERFUSION</text><text class="small" x="265" y="58">warm</text><text class="small" x="635" y="58">cold</text><text class="head" x="55" y="250" transform="rotate(-90 55 250)">CONGESTION</text><text class="small" x="82" y="155">dry</text><text class="small" x="82" y="350">wet</text><g><rect class="good" x="120" y="85" width="290" height="125" rx="18"/><text x="265" y="130">DRY + WARM</text><text class="small" x="265" y="162">compensated</text><rect class="warn" x="490" y="85" width="290" height="125" rx="18"/><text x="635" y="130">DRY + COLD</text><text class="small" x="635" y="162">low output without congestion</text><rect class="warn" x="120" y="290" width="290" height="125" rx="18"/><text x="265" y="335">WET + WARM</text><text class="small" x="265" y="367">congested, perfusing</text><rect class="risk" x="490" y="290" width="290" height="125" rx="18"/><text x="635" y="335">WET + COLD</text><text class="small" x="635" y="367">congestion + hypoperfusion</text></g><text class="small" x="450" y="472">Treat the profile and cause—not edema, creatinine, or blood pressure in isolation</text></svg>}
  {kind === 'ecg-territories' && <svg viewBox="0 0 900 460" role="img" aria-label="ECG leads grouped by myocardial territory"><g transform="translate(80 90)"><rect class="territory inf" x="0" y="0" width="190" height="120" rx="18"/><text class="head" x="95" y="38">INFERIOR</text><text x="95" y="75">II · III · aVF</text><text class="small" x="95" y="100">often RCA, sometimes LCx</text><rect class="territory lat" x="235" y="0" width="190" height="120" rx="18"/><text class="head" x="330" y="38">LATERAL</text><text x="330" y="75">I · aVL · V5–V6</text><text class="small" x="330" y="100">LCx or diagonal territory</text><rect class="territory ant" x="470" y="0" width="190" height="120" rx="18"/><text class="head" x="565" y="38">ANTERIOR</text><text x="565" y="75">V1–V4</text><text class="small" x="565" y="100">LAD territory</text><rect class="territory post" x="118" y="175" width="190" height="120" rx="18"/><text class="head" x="213" y="213">POSTERIOR</text><text x="213" y="250">V7–V9</text><text class="small" x="213" y="275">mirror: V1–V3 depression</text><rect class="territory rv" x="352" y="175" width="190" height="120" rx="18"/><text class="head" x="447" y="213">RIGHT VENTRICLE</text><text x="447" y="250">V3R–V4R</text><text class="small" x="447" y="275">check with inferior MI</text></g><text class="small" x="450" y="425">Territories overlap. Coronary anatomy varies; the ECG localizes myocardium better than it identifies a vessel.</text></svg>}
  <figcaption class="border-t border-clinical-200 px-5 py-4 text-sm leading-6 text-clinical-600 dark:border-clinical-700 dark:text-clinical-300">{caption}</figcaption>
</figure>
<style>
svg{display:block;width:100%;height:auto;padding:1rem;font-family:ui-sans-serif,system-ui,-apple-system,sans-serif}svg text{fill:#263746;text-anchor:middle;font-size:15px;font-weight:650}.small{font-size:11px;font-weight:550;fill:#647382}.head,.zone{font-size:13px;font-weight:800;letter-spacing:.08em;fill:#315f7d}.axis{fill:none;stroke:#8997a2;stroke-width:2}.sys{fill:#f4dfd9}.dia{fill:#dcecf1}.sound path{stroke:#315f7d;stroke-width:5}.labels text{font-size:10px;fill:#647382}.flow{fill:none;stroke:#5b8292;stroke-width:3}.box,.call{fill:#fffdf8;stroke:#8997a2;stroke-width:2}.up{fill:#dcecf1;stroke:#5b8292;stroke-width:2}.arrow{fill:none;stroke:#526273;stroke-width:3}.wave{fill:none;stroke:#315f7d;stroke-width:5}.point text{font-size:24px;fill:#a76559}.guide path{stroke:#c5cdd3;stroke-dasharray:5 5}.good{fill:#e6efe9;stroke:#699078}.warn{fill:#eee5d8;stroke:#8f7b60}.risk{fill:#f4dfd9;stroke:#a76559}.territory{stroke-width:2}.inf{fill:#eee5d8;stroke:#8f7b60}.lat{fill:#e6efe9;stroke:#699078}.ant{fill:#f4dfd9;stroke:#a76559}.post{fill:#dcecf1;stroke:#5b8292}.rv{fill:#e4e1ef;stroke:#756a91}@media(max-width:640px){svg{padding:.25rem}svg text{font-size:12px}.small,.labels text{font-size:8px}.head,.zone{font-size:10px}}
</style>
