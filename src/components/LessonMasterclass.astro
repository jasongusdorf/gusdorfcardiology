---
import type { LessonMasterclass } from '../data/lesson-masterclasses';

const { content, color } = Astro.props as { content: LessonMasterclass; color: string };
---

<section class="my-10 border-t-4 pt-8" style={`border-color:${color}`} aria-labelledby="masterclass-heading">
  <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-700 dark:text-blue-300">Masterclass</p>
  <h2 id="masterclass-heading" class="mt-1 font-heading text-3xl font-semibold text-clinical-900 dark:text-white">From structure to bedside decisions</h2>
  <p class="mt-2 max-w-3xl leading-7 text-clinical-600 dark:text-clinical-300">This is the working layer: build the mechanism, discriminate among competing explanations, and use the result to make a decision.</p>
  <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 border-y border-clinical-200 py-3 text-sm text-clinical-600 dark:border-clinical-700 dark:text-clinical-300" aria-label="Learning objectives">
    {content.objectives.map((objective) => <li class="flex gap-2"><span aria-hidden="true" class="text-blue-600">•</span><span>{objective}</span></li>)}
  </ul>

  <div class="mt-7">
    <div class="mb-4 flex items-baseline gap-3"><span class="text-xs font-bold text-clinical-400">I</span><h3 class="font-heading text-2xl font-semibold text-clinical-900 dark:text-white">Anatomy and physiology</h3></div>
    <div class="grid gap-4 md:grid-cols-2">
      {content.foundations.map((item) => (
        <article class="rounded-xl border border-clinical-200 bg-white p-5 dark:border-clinical-700 dark:bg-clinical-800">
          <h4 class="font-semibold text-clinical-900 dark:text-white">{item.title}</h4>
          <p class="mt-2 text-sm leading-7 text-clinical-600 dark:text-clinical-300">{item.text}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="mt-8">
    <div class="mb-4 flex items-baseline gap-3"><span class="text-xs font-bold text-clinical-400">II</span><h3 class="font-heading text-2xl font-semibold text-clinical-900 dark:text-white">Clinical reasoning</h3></div>
    <div class="overflow-hidden rounded-xl border border-clinical-200 bg-white dark:border-clinical-700 dark:bg-clinical-800">
      {content.reasoning.map((item, index) => (
        <article class:list={["grid gap-2 p-5 sm:grid-cols-[11rem_1fr] sm:gap-5", index > 0 && "border-t border-clinical-200 dark:border-clinical-700"]}>
          <h4 class="font-semibold text-clinical-900 dark:text-white">{item.title}</h4>
          <p class="text-sm leading-7 text-clinical-600 dark:text-clinical-300">{item.text}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="mt-8 rounded-2xl bg-clinical-900 p-5 text-white sm:p-7 dark:bg-black/40">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-300">Worked clinical problem</p>
    <h3 class="mt-2 font-heading text-xl font-semibold">{content.case.stem}</h3>
    <div class="mt-5 grid gap-3 md:grid-cols-2">
      {content.case.moves.map((move, index) => (
        <div class="rounded-xl border border-white/15 bg-white/5 p-4">
          <div class="flex items-center gap-2"><span class="grid h-6 w-6 place-items-center rounded-full bg-blue-500 text-xs font-bold">{index + 1}</span><h4 class="font-semibold">{move.label}</h4></div>
          <p class="mt-2 text-sm leading-6 text-clinical-200">{move.text}</p>
        </div>
      ))}
    </div>
    <div class="mt-4 rounded-xl border-l-4 border-amber-400 bg-white/10 p-4">
      <p class="text-xs font-bold uppercase tracking-wide text-amber-300">Synthesis</p>
      <p class="mt-1 text-sm leading-6 text-clinical-100">{content.case.synthesis}</p>
    </div>
  </div>

  <div class="mt-8">
    <div class="mb-4 flex items-baseline gap-3"><span class="text-xs font-bold text-clinical-400">III</span><h3 class="font-heading text-2xl font-semibold text-clinical-900 dark:text-white">Retrieval practice</h3></div>
    <div class="space-y-2">
      {content.retrieval.map((item, index) => (
        <details class="group rounded-xl border border-clinical-200 bg-white open:border-blue-300 dark:border-clinical-700 dark:bg-clinical-800 dark:open:border-blue-700">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 font-medium text-clinical-900 marker:content-none dark:text-white">
            <span><span class="mr-3 text-xs font-bold text-clinical-400">{String(index + 1).padStart(2, '0')}</span>{item.question}</span>
            <span class="text-xl text-blue-600 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="border-t border-clinical-200 px-4 py-4 pl-12 text-sm leading-6 text-clinical-600 dark:border-clinical-700 dark:text-clinical-300">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
