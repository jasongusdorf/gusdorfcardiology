---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import openMedia from '../../data/cardiology-open-media.json';
import minnesotaMedia from '../../data/cardiology-minnesota-media.json';
import cineMedia from '../../data/cardiology-cine-media.json';
import { displayTitleFor, interpretationFor, sourceNameFor, type CardiologyMedia } from '../../lib/cardiology-media';

const items = [...cineMedia, ...openMedia, ...minnesotaMedia] as CardiologyMedia[];

export function getStaticPaths() {
  return [...cineMedia, ...openMedia, ...minnesotaMedia].map(item => ({ params: { id: item.id }, props: { item } }));
}

const { item } = Astro.props as { item: CardiologyMedia };
const interpretation = interpretationFor(item);
const displayTitle = displayTitleFor(item);
const index = items.findIndex(candidate => candidate.id === item.id);
const previous = items[(index - 1 + items.length) % items.length];
const next = items[(index + 1) % items.length];
---
<BaseLayout title={`${displayTitle} - Cardiology Media - Gusdorf Cardiology`} description={item.description}>
  <main class="cardiology-page mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <Breadcrumb crumbs={[{label:'Home',href:'/'},{label:'Cardiology',href:'/curriculum'},{label:'Media library',href:'/media'},{label:displayTitle}]}/>

    <header class="mt-5 max-w-4xl">
      <p class="cardiology-kicker cardiology-pulse-rule mb-2 text-sm font-semibold uppercase tracking-[0.16em]">{item.modality}{item.mediaKind === 'video' ? ' · Cine loop' : ' · Image'}</p>
      <h1 class="font-heading text-3xl font-bold leading-tight sm:text-5xl">{displayTitle}</h1>
      <p class="mt-4 text-base leading-7 text-clinical-600 dark:text-clinical-300 sm:text-lg sm:leading-8">{item.description}</p>
      <p class="mt-3 text-sm text-clinical-400">From {sourceNameFor(item)} · Openly licensed teaching media</p>
    </header>

    <section class="mt-7 overflow-hidden rounded-2xl border border-clinical-700 bg-black shadow-xl" aria-label="Cardiac study">
      {item.mediaKind === 'video'
        ? <video src={item.src} poster={item.poster} controls autoplay muted loop playsinline preload="metadata" class="mx-auto max-h-[72vh] min-h-48 w-full object-contain">Your browser does not support this video.</video>
        : <img src={item.src} alt={item.description || item.title} width={item.width} height={item.height} class="mx-auto max-h-[72vh] w-auto max-w-full object-contain" />}
    </section>

    <div class="mt-8 grid gap-7 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <article class="space-y-8">
        <details class="rounded-lg border border-clinical-200 bg-warm-white px-4 py-3 text-sm dark:border-clinical-700 dark:bg-clinical-800">
          <summary class="cursor-pointer font-semibold text-clinical-700 marker:text-red-700 dark:text-clinical-200">Reading order mnemonic: <span class="text-red-700 dark:text-red-300">VIEWS</span></summary>
          <div class="mt-3 border-t border-clinical-200 pt-3 text-clinical-600 dark:border-clinical-700 dark:text-clinical-300">
            <p><strong>V</strong>iew &amp; quality → <strong>I</strong>dentify chambers → <strong>E</strong>valuate function → <strong>W</strong>atch valves/walls → <strong>S</strong>eek measurements &amp; missing data.</p>
            <p class="mt-2 leading-6">{interpretation.orientation}</p>
          </div>
        </details>

        <section class="rounded-2xl border border-clinical-200 bg-warm-white p-5 dark:border-clinical-700 dark:bg-clinical-800 sm:p-7">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-red-700 dark:text-red-300">Interpret</p>
          <h2 class="mt-1 font-heading text-2xl font-bold">Source label vs. educational read</h2>
          <div class="mt-4 rounded-xl border-l-4 border-blue-600 bg-blue-50 p-4 dark:bg-blue-950/20">
            <p class="text-xs font-bold uppercase tracking-wide text-blue-700 dark:text-blue-300">What the original source states</p>
            <p class="mt-2 leading-7 text-clinical-700 dark:text-clinical-200">{interpretation.sourceClaim}</p>
          </div>
          <h3 class="mt-6 font-heading text-xl font-semibold">What in the image would support that label</h3>
          <ul class="mt-4 list-disc space-y-2 pl-5 leading-7">
            {interpretation.supportedFindings.map(finding => <li>{finding}</li>)}
          </ul>
          <h3 class="mt-6 font-heading text-xl font-semibold">Apply it clinically</h3>
          <p class="mt-2 leading-7 text-clinical-700 dark:text-clinical-200">{interpretation.clinicalMeaning}</p>
        </section>

        <section class="grid gap-5 md:grid-cols-2">
          <div class="rounded-2xl border border-clinical-200 bg-warm-white p-5 dark:border-clinical-700 dark:bg-clinical-800">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-red-700 dark:text-red-300">Keep the differential open</p>
            <h2 class="mt-1 font-heading text-xl font-bold">What else could look like this?</h2>
            <ul class="mt-4 space-y-3 text-sm leading-6">{interpretation.differential.map(item => <li class="flex gap-2"><span class="text-red-700">•</span><span>{item}</span></li>)}</ul>
          </div>
          <div class="rounded-2xl border border-clinical-200 bg-warm-white p-5 dark:border-clinical-700 dark:bg-clinical-800">
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-red-700 dark:text-red-300">Complete the study</p>
            <h2 class="mt-1 font-heading text-xl font-bold">What data are still missing?</h2>
            <ul class="mt-4 space-y-3 text-sm leading-6">{interpretation.missingData.map(item => <li class="flex gap-2"><span class="text-red-700">•</span><span>{item}</span></li>)}</ul>
          </div>
        </section>

        <details class="group rounded-2xl border border-emerald-300 bg-emerald-50 p-5 dark:border-emerald-900 dark:bg-emerald-950/20 sm:p-7">
          <summary class="cursor-pointer list-none"><p class="text-xs font-bold uppercase tracking-[0.16em] text-emerald-700 dark:text-emerald-300">Read it yourself</p><h2 class="mt-1 font-heading text-xl font-bold">{interpretation.selfTest.prompt}</h2><p class="mt-3 text-sm font-semibold text-emerald-800 group-open:hidden dark:text-emerald-300">Reveal teaching answer →</p></summary>
          <div class="mt-4 border-t border-emerald-300 pt-4 leading-7 text-clinical-700 dark:border-emerald-800 dark:text-clinical-200"><strong>Teaching answer:</strong> {interpretation.selfTest.answer}</div>
        </details>

        <section>
          <h2 class="font-heading text-2xl font-bold">Interpretive pitfalls</h2>
          <ul class="mt-4 space-y-3">
            {interpretation.pitfalls.map(pitfall => <li class="rounded-xl border-l-4 border-amber-500 bg-amber-50 px-4 py-3 leading-7 text-amber-950 dark:bg-amber-950/20 dark:text-amber-100">{pitfall}</li>)}
          </ul>
        </section>

        <details class="rounded-xl border border-clinical-200 p-4 text-sm leading-6 text-clinical-500 dark:border-clinical-700">
          <summary class="cursor-pointer font-semibold text-clinical-700 dark:text-clinical-200">About this interpretation</summary>
          <p class="mt-3">The source description is the asset-level clinical label supplied by the original publisher. This educational framework is derived from that label and modality; it is not an independent read of a complete examination. Measurements, absent sequences, acquisition quality, and patient context may materially change the interpretation.</p>
        </details>
      </article>

      <aside class="space-y-5 lg:sticky lg:top-24 lg:self-start">
        <details class="rounded-xl border border-clinical-200 bg-warm-white p-4 text-sm leading-6 text-clinical-500 dark:border-clinical-700 dark:bg-clinical-800">
          <summary class="cursor-pointer font-semibold text-clinical-700 dark:text-clinical-200">Source, credit & license</summary>
          <dl class="mt-4 space-y-3">
            <div><dt class="font-semibold">Creator</dt><dd>{item.creator}</dd></div>
            {item.credit && <div><dt class="font-semibold">Credit</dt><dd>{item.credit}</dd></div>}
            <div><dt class="font-semibold">License</dt><dd><a href={item.licenseUrl} rel="license" class="text-red-700 underline dark:text-red-300">{item.license}</a></dd></div>
            <div><dt class="font-semibold">Changes</dt><dd>{item.changes}</dd></div>
          </dl>
          <a href={item.sourcePage} class="mt-4 inline-block font-semibold text-red-700 underline dark:text-red-300">View original record →</a>
        </details>

        <nav class="grid grid-cols-2 gap-3 text-sm" aria-label="Media studies">
          <a href={`/media/${previous.id}`} class="min-w-0 rounded-xl border border-clinical-300 p-3 hover:border-red-600 dark:border-clinical-600"><span class="block text-xs text-clinical-400">← Previous</span><span class="mt-1 block truncate font-semibold">{displayTitleFor(previous)}</span></a>
          <a href={`/media/${next.id}`} class="min-w-0 rounded-xl border border-clinical-300 p-3 text-right hover:border-red-600 dark:border-clinical-600"><span class="block text-xs text-clinical-400">Next →</span><span class="mt-1 block truncate font-semibold">{displayTitleFor(next)}</span></a>
          <a href="/media" class="col-span-2 rounded-xl bg-red-800 p-3 text-center font-semibold text-white hover:bg-red-700">Back to all studies</a>
        </nav>
      </aside>
    </div>
  </main>
</BaseLayout>
