---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardiologySearch from '../components/CardiologySearch';
import { allCardiologyLessons, cardiologyTracks } from '../data/cardiology-curriculum';
import guidelines from '../data/cardiology-guidelines.json';
import sounds from '../data/heart-sounds-library.json';
import ecg from '../data/ecg-library.json';

const ecgData = ecg as any;
const searchItems = [
  ...allCardiologyLessons.map((lesson) => ({ title: lesson.title, description: lesson.dek, href: `/curriculum/${lesson.trackSlug}/${lesson.slug}`, section: lesson.trackTitle, terms: lesson.searchTerms })),
  ...(guidelines as any[]).map((g) => ({ title: g.title, description: `${g.organization} · ${g.year}`, href: '/guidelines', section: 'Guidelines', terms: [g.organization, g.topic, String(g.year)] })),
  { title: 'ECG Library', description: `${ecgData.totalTracings} annotated 12-lead ECGs`, href: '/ecg', section: 'ECG', terms: ['electrocardiogram', 'rhythm', 'tracing'] },
  { title: 'Heart Sound Library', description: `${(sounds as any[]).length} narrated auscultation recordings`, href: '/heart-sounds', section: 'Physical Examination', terms: ['murmur', 'auscultation', 'S1', 'S2'] },
];
---
<BaseLayout title="Gusdorf Cardiology" description="A free clinical cardiology curriculum, ECG library, heart sounds, and current guideline directory for clinicians and trainees.">
  <section class="border-b border-clinical-200 bg-warm-white dark:border-clinical-700 dark:bg-clinical-900">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-red-700 dark:text-red-400">Clinical cardiology, made navigable</p>
      <h1 class="mt-4 max-w-4xl font-heading text-5xl font-medium leading-[1.05] tracking-tight text-clinical-900 dark:text-white sm:text-7xl">Learn the heart from bedside finding to definitive test.</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-clinical-600 dark:text-clinical-300">A free, clinician-built cardiology curriculum with practical lessons, real ECGs, narrated heart sounds, and a maintained guideline library.</p>
      <div class="mt-9 max-w-3xl"><CardiologySearch items={searchItems} client:load /></div>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      <a href="/curriculum" class="rounded-2xl border border-clinical-200 bg-warm-white p-6 hover:border-red-700 dark:border-clinical-700 dark:bg-clinical-800"><p class="text-xs font-bold uppercase tracking-widest text-red-700 dark:text-red-400">Curriculum</p><h2 class="mt-3 font-heading text-2xl">{allCardiologyLessons.length} clinical lessons</h2><p class="mt-3 text-sm text-clinical-600 dark:text-clinical-300">Organized from foundations through advanced practice.</p></a>
      <a href="/ecg" class="rounded-2xl border border-clinical-200 bg-warm-white p-6 hover:border-red-700 dark:border-clinical-700 dark:bg-clinical-800"><p class="text-xs font-bold uppercase tracking-widest text-red-700 dark:text-red-400">ECG</p><h2 class="mt-3 font-heading text-2xl">{ecgData.totalTracings} real tracings</h2><p class="mt-3 text-sm text-clinical-600 dark:text-clinical-300">Browse by diagnosis or test yourself in quiz mode.</p></a>
      <a href="/heart-sounds" class="rounded-2xl border border-clinical-200 bg-warm-white p-6 hover:border-red-700 dark:border-clinical-700 dark:bg-clinical-800"><p class="text-xs font-bold uppercase tracking-widest text-red-700 dark:text-red-400">Auscultation</p><h2 class="mt-3 font-heading text-2xl">{(sounds as any[]).length} recordings</h2><p class="mt-3 text-sm text-clinical-600 dark:text-clinical-300">Narrated teaching recordings from the Harvey collection.</p></a>
      <a href="/guidelines" class="rounded-2xl border border-clinical-200 bg-warm-white p-6 hover:border-red-700 dark:border-clinical-700 dark:bg-clinical-800"><p class="text-xs font-bold uppercase tracking-widest text-red-700 dark:text-red-400">Evidence</p><h2 class="mt-3 font-heading text-2xl">{(guidelines as any[]).length} current guidelines</h2><p class="mt-3 text-sm text-clinical-600 dark:text-clinical-300">ACC/AHA and ESC source documents in one place.</p></a>
    </div>
  </section>
  <section class="border-y border-clinical-200 bg-clinical-900 text-white dark:border-clinical-700">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-4 py-12 sm:px-6 md:flex-row md:items-center lg:px-8">
      <div><p class="text-xs font-bold uppercase tracking-widest text-blue-300">Looking for AI in cardiology?</p><h2 class="mt-2 font-heading text-3xl">That work lives at LLMs for Doctors.</h2><p class="mt-2 max-w-2xl text-clinical-300">Research summaries on ECG models, echocardiography, foundation models, and clinical AI remain part of the dedicated medical-AI site.</p></div>
      <a href="https://llmsfordoctors.com/trials?tag=cardiology" class="shrink-0 rounded-lg bg-white px-5 py-3 font-semibold text-clinical-900 hover:bg-blue-50">Browse AI + cardiology ↗</a>
    </div>
  </section>
</BaseLayout>
