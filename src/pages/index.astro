---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardiologySearch from '../components/CardiologySearch';
import { About3 } from '../components/ui/about-3';
import { allCardiologyLessons, cardiologyTracks } from '../data/cardiology-curriculum';
import guidelines from '../data/cardiology-guidelines.json';
import sounds from '../data/heart-sounds-library.json';
import ecg from '../data/ecg-library.json';
const ecgData = ecg as any;
const ecgCount = ecgData.categories.reduce((sum: number, category: any) => sum + category.tracings.length, 0);
const searchItems = [
  ...allCardiologyLessons.map((lesson) => ({ title: lesson.title, description: lesson.dek, href: `/curriculum/${lesson.trackSlug}/${lesson.slug}`, section: lesson.trackTitle, terms: lesson.searchTerms })),
  ...(guidelines as any[]).map((g) => ({ title: g.title, description: `${g.organization} · ${g.year}`, href: '/guidelines', section: 'Guidelines', terms: [g.organization, g.topic, String(g.year)] })),
  { title: 'ECG Library', description: `${ecgCount} annotated 12-lead ECGs`, href: '/ecg', section: 'ECG', terms: ['electrocardiogram', 'rhythm', 'tracing'] },
  { title: 'Heart Sound Library', description: `${(sounds as any[]).length} narrated auscultation recordings`, href: '/heart-sounds', section: 'Physical Examination', terms: ['murmur', 'auscultation', 'S1', 'S2'] },
];
const features = [
  { number: '01', label: 'Curriculum', title: `${allCardiologyLessons.length} clinical lessons`, body: 'A practical sequence from physiology and bedside examination through diagnosis and management.', href: '/curriculum', cta: 'Explore the curriculum' },
  { number: '02', label: 'Electrocardiography', title: `${ecgCount} real ECGs`, body: 'Browse by diagnosis or commit to an interpretation before revealing the complete read.', href: '/ecg', cta: 'Open the ECG library' },
  { number: '03', label: 'Auscultation', title: `${(sounds as any[]).length} narrated recordings`, body: 'Learn murmurs, splitting, gallops, and congenital findings from the Harvey teaching collection.', href: '/heart-sounds', cta: 'Listen to heart sounds' },
];
---
<BaseLayout title="Gusdorf Cardiology" description="A free clinical cardiology curriculum, ECG library, heart sounds, and current guideline directory for clinicians and trainees.">
  <section class="cardiac-grid relative overflow-hidden border-b border-clinical-200 bg-warm-white dark:border-clinical-700 dark:bg-clinical-900">
    <div class="pointer-events-none absolute -right-28 -top-32 h-[32rem] w-[32rem] rounded-full bg-blue-100/70 blur-3xl dark:bg-blue-950/30"></div>
    <div class="relative mx-auto grid w-full max-w-7xl gap-12 overflow-hidden px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-center lg:px-8 lg:py-28">
      <div class="min-w-0 w-full max-w-full overflow-hidden">
        <p class="eyebrow">Clinical cardiology, made navigable</p>
        <h1 class="mt-5 max-w-4xl font-heading text-5xl font-medium leading-[1.02] tracking-[-0.045em] text-clinical-900 dark:text-white sm:text-7xl lg:text-[5.2rem]">Read the heart.<br/><span class="text-blue-700 dark:text-blue-300">Treat the patient.</span></h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-clinical-600 dark:text-clinical-300">A free, clinician-built learning system that connects physiology, bedside findings, ECGs, diagnostic testing, and current guidelines.</p>
        <div class="mt-9 max-w-2xl"><CardiologySearch items={searchItems} client:load /></div>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm text-clinical-500 dark:text-clinical-400"><span>{allCardiologyLessons.length} lessons</span><span>{ecgCount} ECGs</span><span>{(sounds as any[]).length} recordings</span><span>Free, no account</span></div>
      </div>
      <div class="relative mx-auto hidden aspect-square w-full max-w-sm lg:block" aria-hidden="true">
        <div class="absolute inset-0 rounded-full border border-blue-200 bg-white/70 shadow-[0_30px_80px_rgb(127_29_29/0.12)] backdrop-blur dark:border-blue-900 dark:bg-clinical-800/80"></div>
        <svg viewBox="0 0 360 360" class="absolute inset-0 h-full w-full" fill="none"><circle cx="180" cy="180" r="144" stroke="#7f1d1d" stroke-opacity=".16"/><circle cx="180" cy="180" r="112" stroke="#7f1d1d" stroke-opacity=".1"/><path d="M50 184h68l16-38 30 83 28-122 25 77h93" stroke="#991b1b" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="50" cy="184" r="5" fill="#991b1b"/><circle cx="310" cy="184" r="5" fill="#991b1b"/></svg>
        <p class="absolute inset-x-0 bottom-16 text-center text-xs font-bold uppercase tracking-[0.24em] text-clinical-500">Observe · interpret · act</p>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
    <div class="mb-10 flex items-end justify-between gap-6 border-t border-clinical-300 pt-4 dark:border-clinical-700"><div><p class="eyebrow">Core library</p><h2 class="mt-2 font-heading text-3xl font-medium tracking-tight text-clinical-900 dark:text-white sm:text-4xl">Three ways into cardiology</h2></div><a href="/curriculum" class="hidden text-sm font-semibold text-blue-700 hover:underline sm:block">View all lessons →</a></div>
    <div class="grid gap-5 lg:grid-cols-3">
      {features.map((item) => <a href={item.href} class="clinical-card group flex min-h-72 flex-col p-7"><div class="flex items-center justify-between"><p class="eyebrow">{item.label}</p><span class="font-mono text-xs text-clinical-400">{item.number}</span></div><h3 class="mt-10 font-heading text-3xl leading-tight text-clinical-900 transition group-hover:text-blue-700 dark:text-white dark:group-hover:text-blue-300">{item.title}</h3><p class="mt-4 leading-7 text-clinical-600 dark:text-clinical-300">{item.body}</p><p class="mt-auto pt-8 text-sm font-bold text-clinical-800 dark:text-clinical-100">{item.cta} <span class="inline-block transition group-hover:translate-x-1">→</span></p></a>)}
    </div>
  </section>
  <About3 />
  <section class="border-y border-clinical-200 bg-warm-white dark:border-clinical-700 dark:bg-clinical-800/40">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 md:grid-cols-[1fr_1.2fr] md:items-center lg:px-8">
      <div><p class="eyebrow">Guideline library</p><h2 class="mt-3 font-heading text-4xl font-medium tracking-tight text-clinical-900 dark:text-white">Evidence without the scavenger hunt.</h2><p class="mt-4 max-w-lg leading-7 text-clinical-600 dark:text-clinical-300">Current ACC/AHA and ESC guidance, organized by topic and linked directly to the official source.</p><a href="/guidelines" class="mt-7 inline-flex rounded-full bg-blue-700 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-blue-800">Browse {(guidelines as any[]).length} guidelines</a></div>
      <div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-clinical-200 bg-clinical-200 dark:border-clinical-700 dark:bg-clinical-700">{cardiologyTracks.slice(0, 6).map((track) => <a href={`/curriculum/${track.slug}`} class="bg-clinical-50 p-5 transition hover:bg-white dark:bg-clinical-900 dark:hover:bg-clinical-800"><span class="text-sm font-semibold text-clinical-800 dark:text-clinical-100">{track.title}</span><span class="mt-1 block text-xs text-clinical-500">{track.lessons.length} lessons</span></a>)}</div>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl bg-clinical-900 px-7 py-10 text-white sm:px-10 sm:py-12">
      <svg class="absolute right-0 top-1/2 h-40 w-1/2 -translate-y-1/2 opacity-15" viewBox="0 0 500 120" fill="none" aria-hidden="true"><path d="M0 65h100l25-47 37 90 42-98 35 55h261" stroke="white" stroke-width="4"/></svg>
      <div class="relative max-w-2xl"><p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-300">AI + cardiology</p><h2 class="mt-3 font-heading text-3xl sm:text-4xl">Clinical AI belongs in its own evidence library.</h2><p class="mt-4 leading-7 text-clinical-300">Research on ECG models, echocardiography, foundation models, and clinical AI remains at LLMs for Doctors.</p><a href="https://llmsfordoctors.com/trials?tag=cardiology" class="mt-7 inline-flex rounded-full bg-white px-5 py-2.5 text-sm font-bold text-clinical-900 transition hover:bg-blue-50">Browse AI-cardiology research ↗</a></div>
    </div>
  </section>
</BaseLayout>
