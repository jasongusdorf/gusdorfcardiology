---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { cardiologyConcepts } from '../../data/cardiology-concepts';
---

<BaseLayout title="Cardiology Concepts" description="Deep, linked explanations of the physiologic concepts that connect cardiac cell biology, pressure-volume mechanics, and bedside care.">
  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Concepts' }]} />
    <header class="mb-10 max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">Mechanism library</p>
      <h1 class="mt-2 font-heading text-4xl font-bold text-clinical-900 dark:text-white">Cardiology concepts, from myocyte to bedside</h1>
      <p class="mt-4 text-lg leading-8 text-clinical-600 dark:text-clinical-300">Follow the terms embedded throughout the curriculum when you want the deeper physiology—not merely a one-line definition.</p>
    </header>
    <div class="grid gap-5 md:grid-cols-2">
      {cardiologyConcepts.map((concept) => (
        <a href={`/concepts/${concept.slug}`} class="group rounded-2xl border border-clinical-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-blue-400 hover:shadow-lg dark:border-clinical-700 dark:bg-clinical-800">
          <h2 class="font-heading text-2xl font-semibold text-clinical-900 group-hover:text-blue-700 dark:text-white dark:group-hover:text-blue-300">{concept.term}</h2>
          <p class="mt-3 leading-7 text-clinical-600 dark:text-clinical-300">{concept.definition}</p>
          <span class="mt-5 inline-block text-sm font-semibold text-blue-600 dark:text-blue-400">Go deeper →</span>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
