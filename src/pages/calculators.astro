---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CardiologyCalculators from '../components/CardiologyCalculators';
---

<BaseLayout title="Cardiology Calculators & Decision Pathways - Gusdorf Cardiology" description="Transparent cardiology risk calculators and practical decision pathways with clinical guardrails.">
  <div class="cardiology-page mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Cardiology', href: '/curriculum' }, { label: 'Calculators & pathways' }]} />
    <header class="cardiology-hero mb-8 max-w-5xl">
      <p class="cardiology-kicker cardiology-pulse-rule text-sm font-semibold uppercase tracking-[.18em]">Decision support education</p>
      <h1 class="mt-2 font-heading text-3xl font-bold sm:text-5xl">Cardiology Calculators & Decision Pathways</h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-clinical-600 dark:text-clinical-300">Make every input visible. See the score, then read the population, limitation, and next clinical sequence before acting.</p>
    </header>
    <CardiologyCalculators client:load />
    <footer class="mt-10 border-t border-clinical-200 pt-4 text-xs text-clinical-400 dark:border-clinical-700 dark:text-clinical-500">
      Evidence reviewed September 17, 2026 · <a href="/editorial-standards" class="underline underline-offset-2 hover:text-blue-600">Editorial standards and review status</a>
    </footer>
  </div>
</BaseLayout>
