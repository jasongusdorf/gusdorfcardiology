---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CardiologyDiagram from '../../../components/CardiologyDiagram.astro';
import ClinicalDiagram from '../../../components/ClinicalDiagram.astro';
import AdvancedCardiologyDiagram from '../../../components/AdvancedCardiologyDiagram.astro';
import LessonLearningLayers from '../../../components/LessonLearningLayers.astro';
import LessonMasterclass from '../../../components/LessonMasterclass.astro';
import LessonConceptMap from '../../../components/LessonConceptMap.astro';
import LessonMastery from '../../../components/LessonMastery';
import SpecialtyModules from '../../../components/SpecialtyModules.astro';
import guidelines from '../../../data/cardiology-guidelines.json';
import { cardiologyTracks, type CardiologyLesson, type CardiologyTrack } from '../../../data/cardiology-curriculum';
import { lessonLearningModels, lessonNejmReviews } from '../../../data/lesson-learning-models';
import { lessonEnhancements } from '../../../data/lesson-enhancements';
import { lessonMasterclasses } from '../../../data/lesson-masterclasses';
import { lessonMastery } from '../../../data/lesson-mastery';
import { formulaExamples } from '../../../data/formula-examples';
import { specialtyModules } from '../../../data/specialty-modules';
import { cardiologyConcepts, linkCardiologyConcepts } from '../../../data/cardiology-concepts';
import katex from 'katex';
import 'katex/dist/katex.min.css';

export function getStaticPaths() {
  return cardiologyTracks.flatMap((track) => track.lessons.map((lesson) => ({
    params: { track: track.slug, lesson: lesson.slug },
    props: { track, lesson },
  })));
}

const { track, lesson } = Astro.props as { track: CardiologyTrack; lesson: CardiologyLesson };
const matchingGuidelines = (guidelines as any[]).filter((guideline) =>
  lesson.guidelineTopics?.some((topic) => guideline.topic.toLowerCase().includes(topic.toLowerCase())),
);
const enhancements = lessonEnhancements[lesson.slug];
// Generated atlas plates are temporarily withheld after the 2026-09-20
// clinical audit. They remain in the repository for traceability, but are not
// shown as teaching figures until each plate has an approved replacement.
const auditedFigures = enhancements?.figures?.filter(
  (figure) => !figure.src.startsWith('/images/curriculum/generated/'),
);
const renderFormula = (latex: string) => katex.renderToString(latex, {
  throwOnError: false,
  output: 'html',
  strict: false,
});
const sectionClass = 'rounded-xl border border-clinical-200 bg-warm-white p-5 dark:border-clinical-700 dark:bg-clinical-800';
const learningModel = lessonLearningModels[lesson.slug];
const nejmReviews = lessonNejmReviews[lesson.slug] ?? [];
const masterclass = lessonMasterclasses[lesson.slug];
const masteryQuestions = lessonMastery[lesson.slug] ?? [];
const modules = specialtyModules[lesson.slug] ?? [];
const lessonIndex = track.lessons.findIndex((item) => item.slug === lesson.slug);
const previousLesson = lessonIndex > 0 ? track.lessons[lessonIndex - 1] : undefined;
const nextLesson = lessonIndex < track.lessons.length - 1 ? track.lessons[lessonIndex + 1] : undefined;
---

<BaseLayout title={`${lesson.title} - Cardiology`} description={lesson.dek}>
  <article class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumb crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Cardiology', href: '/curriculum' },
      { label: track.title, href: `/curriculum/${track.slug}` },
      { label: lesson.title },
    ]} />

    <header class="mb-10">
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <span class="text-sm font-semibold uppercase tracking-[0.15em]" style={`color:${track.color}`}>{track.title}</span>
        <span class="text-clinical-300">•</span>
        <span class="rounded-full bg-clinical-100 px-2.5 py-1 text-xs font-medium text-clinical-600 dark:bg-clinical-700 dark:text-clinical-300">{lesson.level}</span>
      </div>
      <h1 class="font-heading text-3xl font-bold text-clinical-900 dark:text-clinical-50 sm:text-4xl">{lesson.title}</h1>
      <p class="mt-3 text-lg leading-8 text-clinical-600 dark:text-clinical-300" set:html={linkCardiologyConcepts(lesson.dek)} />
    </header>

    <section class={`${sectionClass} mb-5 border-l-4`} style={`border-left-color:${track.color}`}>
      <h2 class="font-heading text-xl font-semibold text-clinical-900 dark:text-clinical-50">Mechanism</h2>
      <p class="mt-3 leading-7 text-clinical-700 dark:text-clinical-200" set:html={linkCardiologyConcepts(lesson.mechanism)} />
    </section>

    {lesson.slug === 'cardiac-cycle-and-pressure-volume-loops' && (
      <nav class="mb-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-label="Hemodynamic concept deep dives">
        {cardiologyConcepts.map((concept) => (
          <a href={`/concepts/${concept.slug}`} class="rounded-xl border border-clinical-200 bg-white p-4 transition hover:border-blue-400 hover:shadow-sm dark:border-clinical-700 dark:bg-clinical-800">
            <span class="font-heading text-lg font-semibold text-clinical-900 dark:text-white">{concept.term}</span>
            <span class="mt-1 block text-xs leading-5 text-clinical-500 dark:text-clinical-400">Cell biology → chamber mechanics → bedside</span>
          </a>
        ))}
      </nav>
    )}

    {lesson.diagrams?.map((diagram) => <CardiologyDiagram kind={diagram} />)}
    {lesson.clinicalDiagram && <ClinicalDiagram kind={lesson.clinicalDiagram} />}
    {lesson.advancedDiagram && <AdvancedCardiologyDiagram kind={lesson.advancedDiagram} />}

    {auditedFigures?.length && (
      <section class="mb-8" aria-labelledby="visual-explainer-heading">
        <div class="mb-3 flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-clinical-400">Visual atlas</p>
            <h2 id="visual-explainer-heading" class="mt-1 font-heading text-2xl font-semibold text-clinical-900 dark:text-clinical-50">See the structure, then explain the physiology</h2>
          </div>
        </div>
        <div class="grid gap-5 md:grid-cols-2">
          {auditedFigures.map((figure) => (
            <figure class:list={[
              'overflow-hidden rounded-xl border border-clinical-200 bg-white dark:border-clinical-700 dark:bg-clinical-800',
              figure.wide && 'md:col-span-2',
            ]}>
              <a href={figure.sourceUrl} target="_blank" rel="noreferrer" class="block bg-white">
                <img src={figure.src} alt={figure.alt} loading="lazy" decoding="async" referrerpolicy="no-referrer" class="h-auto max-h-[36rem] w-full object-contain p-3" />
              </a>
              <figcaption class="border-t border-clinical-200 p-4 text-sm leading-6 text-clinical-600 dark:border-clinical-700 dark:text-clinical-300">
                <p set:html={linkCardiologyConcepts(figure.caption)} />
                <p class="mt-2 text-[0.7rem] text-clinical-400"><a href={figure.sourceUrl} target="_blank" rel="noreferrer" class="underline decoration-clinical-200 underline-offset-2 hover:text-blue-600">{figure.credit}</a> · {figure.license}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {masterclass && <LessonConceptMap content={masterclass} color={track.color} />}

    {learningModel && <LessonLearningLayers model={learningModel} color={track.color} />}

    {masterclass && <LessonMasterclass content={masterclass} color={track.color} />}

    {modules.length > 0 && <SpecialtyModules modules={modules} />}

    {masteryQuestions.length > 0 && <LessonMastery slug={lesson.slug} questions={masteryQuestions} client:load />}

    {enhancements?.formulas?.length && (
      <section class={`${sectionClass} mb-5`} aria-labelledby="equations-heading">
        <div class="flex items-baseline gap-3">
          <span class="text-xs font-bold text-clinical-400">∑</span>
          <h2 id="equations-heading" class="font-heading text-xl font-semibold text-clinical-900 dark:text-clinical-50">Equations that sharpen the bedside model</h2>
        </div>
        <div class="mt-4 grid gap-3 md:grid-cols-2">
          {enhancements.formulas.map((formula) => (
            <div class="rounded-lg border border-clinical-200 bg-clinical-50 p-4 dark:border-clinical-700 dark:bg-clinical-900">
              <h3 class="text-sm font-semibold text-clinical-800 dark:text-clinical-100">{formula.name}</h3>
              <div class="my-3 overflow-x-auto py-1 text-center text-lg text-clinical-900 dark:text-white" set:html={renderFormula(formula.latex)} />
              <p class="text-sm leading-6 text-clinical-600 dark:text-clinical-300" set:html={linkCardiologyConcepts(formula.interpretation)} />
              {formula.variables && <p class="mt-2 text-xs leading-5 text-clinical-400">Units/terms: {formula.variables}</p>}
              {formulaExamples[formula.name] && (
                <details class="mt-3 rounded-lg border border-blue-200 bg-white dark:border-blue-900 dark:bg-clinical-800">
                  <summary class="cursor-pointer px-3 py-2 text-xs font-bold uppercase tracking-wide text-blue-700 dark:text-blue-300">Worked example</summary>
                  <div class="border-t border-blue-100 p-3 text-xs leading-5 text-clinical-600 dark:border-blue-900 dark:text-clinical-300">
                    <p><strong>Given:</strong> {formulaExamples[formula.name].inputs}</p>
                    <p><strong>Substitute:</strong> {formulaExamples[formula.name].calculation}</p>
                    <p><strong>Result:</strong> {formulaExamples[formula.name].result}</p>
                    <p class="mt-2"><strong>Decision:</strong> {formulaExamples[formula.name].clinicalUse}</p>
                  </div>
                </details>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="grid gap-5 md:grid-cols-2">
      {[
        { title: 'Findings', items: lesson.findings, number: '01' },
        { title: 'Tests and interpretation', items: lesson.testing, number: '02' },
        { title: 'Management', items: lesson.management, number: '03' },
        { title: 'Common pitfalls', items: lesson.pitfalls, number: '04' },
      ].map((section) => (
        <section class={sectionClass}>
          <div class="flex items-baseline gap-3">
            <span class="text-xs font-bold text-clinical-400">{section.number}</span>
            <h2 class="font-heading text-xl font-semibold text-clinical-900 dark:text-clinical-50">{section.title}</h2>
          </div>
          <ul class="mt-3 space-y-3 text-sm leading-6 text-clinical-700 dark:text-clinical-200">
            {section.items.map((item) => <li class="flex gap-2"><span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500"></span><span set:html={linkCardiologyConcepts(item)} /></li>)}
          </ul>
        </section>
      ))}
    </div>

    <section class="mt-8 rounded-xl bg-clinical-50 p-5 dark:bg-clinical-900">
        <h2 class="font-heading text-xl font-semibold text-clinical-900 dark:text-clinical-50">Continue learning</h2>
        {lesson.related?.length && (
          <div class="mt-3 flex flex-wrap gap-2">
            {lesson.related.map((item) => <a href={item.href} class="rounded-full border border-clinical-200 bg-white px-3 py-1.5 text-sm text-blue-600 hover:border-blue-500 dark:border-clinical-700 dark:bg-clinical-800 dark:text-blue-400">{item.label}</a>)}
          </div>
        )}
        {enhancements?.resources?.length && (
          <div class="mt-5">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-clinical-500">External visual teaching</h3>
            <ul class="mt-2 space-y-2">
              {enhancements.resources.map((resource) => (
                <li><a href={resource.href} target={resource.href.startsWith('/') ? undefined : '_blank'} rel={resource.href.startsWith('/') ? undefined : 'noreferrer'} class="text-sm text-blue-600 hover:underline dark:text-blue-400">{resource.label} <span class="text-clinical-400">— {resource.source}</span>{!resource.href.startsWith('/') && ' ↗'}</a></li>
              ))}
            </ul>
          </div>
        )}
        {matchingGuidelines.length > 0 && (
          <div class="mt-5">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-clinical-500">Current guidelines</h3>
            <ul class="mt-2 space-y-2">
              {matchingGuidelines.map((guideline) => (
                <li><a href={guideline.landingUrl} target="_blank" rel="noreferrer" class="text-sm text-blue-600 hover:underline dark:text-blue-400">{guideline.title} ↗</a></li>
              ))}
            </ul>
            <a href="/guidelines" class="mt-3 inline-block text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">Browse the full guideline library →</a>
          </div>
        )}
        {nejmReviews.length > 0 && (
          <div class="mt-5 border-t border-clinical-200 pt-5 dark:border-clinical-700">
            <h3 class="text-sm font-semibold uppercase tracking-wide text-clinical-500">Further reading · New England Journal of Medicine</h3>
            <ul class="mt-3 space-y-3">
              {nejmReviews.map((item) => (
                <li>
                  <a href={item.url} target="_blank" rel="noreferrer" class="font-medium text-blue-700 hover:underline dark:text-blue-400">{item.title} ↗</a>
                  <p class="mt-1 text-sm leading-6 text-clinical-600 dark:text-clinical-300">{item.note}</p>
                </li>
              ))}
            </ul>
            <p class="mt-3 text-xs leading-5 text-clinical-500">Links resolve through DOI to the article’s canonical NEJM page. Access may depend on institutional or personal subscription.</p>
          </div>
        )}
        <div class="mt-5">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-clinical-500">Core textbook references</h3>
          <ul class="mt-2 space-y-1 text-sm leading-6 text-clinical-600 dark:text-clinical-300">
            {track.references.map((reference) => <li>• {reference}</li>)}
          </ul>
        </div>
      </section>

    <footer class="mt-10 border-t border-clinical-200 pt-4 text-xs text-clinical-400 dark:border-clinical-700 dark:text-clinical-500">
      <p>Evidence reviewed September 19, 2026 · <a href="/editorial-standards" class="underline underline-offset-2 hover:text-blue-600">Editorial standards and review status</a></p>
    </footer>

    <nav class="mt-8 grid gap-3 sm:grid-cols-2" aria-label="Lesson navigation">
      {previousLesson ? (
        <a href={`/curriculum/${track.slug}/${previousLesson.slug}`} class="rounded-xl border border-clinical-200 bg-white p-4 transition hover:border-blue-400 hover:shadow-sm dark:border-clinical-700 dark:bg-clinical-800">
          <span class="text-xs font-bold uppercase tracking-wide text-clinical-400">← Previous</span>
          <span class="mt-1 block font-semibold text-clinical-900 dark:text-white">{previousLesson.title}</span>
        </a>
      ) : <span />}
      {nextLesson && (
        <a href={`/curriculum/${track.slug}/${nextLesson.slug}`} class="rounded-xl border border-clinical-200 bg-white p-4 text-right transition hover:border-blue-400 hover:shadow-sm dark:border-clinical-700 dark:bg-clinical-800">
          <span class="text-xs font-bold uppercase tracking-wide text-clinical-400">Next →</span>
          <span class="mt-1 block font-semibold text-clinical-900 dark:text-white">{nextLesson.title}</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
